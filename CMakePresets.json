{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [ { "name": "default", "configurePreset": "default", "configuration": "Release" } ],
  "testPresets": [ { "name": "default", "configurePreset": "default", "configuration": "Release", "output": { "outputOnFailure": true } } ]
}
